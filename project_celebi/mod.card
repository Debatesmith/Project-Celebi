return {
    summary = "Continue a Gen 1 trainer's journey into Pokemon Gold.",
    author = "Project Celebi contributors",
    tags = { "tool", "save-transfer", "gen2", "continuity" },

    differences = {
        added = {
            "Adds START -> CELEBI in Pokemon Gold.",
            "Detects native Red, Blue, and Yellow Gen1Recomp save slots.",
            "Reads the selected active Gen 1 slot through SaveData.load(version), the same engine path used by normal Continue.",
            "Creates a separate Gold Project Celebi save slot instead of overwriting either source save.",
            "Transfers trainer name/ID, the six-member party, Gen 1 Pokedex history, and direct-compatible Kanto position.",
            "Recalculates Gen 2 stats/gender/shininess from the transferred Gen 1 DVs and Stat EXP using Gold's own Mon implementation.",
        },
        changed = {
            "Scales Johto trainer parties around the frozen Project Celebi Difficulty Rating, with bosses slightly above it.",
            "Raises ordinary Johto wild encounters into a catch-up band about 10-15 levels below the Project Celebi Rating.",
            "Preserves vanilla encounter species/tables and authored trainer moves/items while changing combat levels.",
            "Restores Silver's Johto rival campaign after the Project Celebi New Bark sighting while skipping the rookie Cherrygrove battle.",
            "Repairs Sprout Tower and Burned Tower pre-visible Silver scenes with Gold's native live-object appear path.",
            "Prevents the Project Celebi HM menu compatibility shim from leaking temporary Johto badge state.",
            "Opens the Route 22/Viridian side of Victory Road Gate for imported Champions without touching Gold's Snorlax or Mt. Silver events.",
        },
        known = {
            "The Project Celebi Difficulty Rating freezes when Johto is first unlocked; later party changes do not retune the campaign.",
            "Kanto trainers and wild encounters are intentionally left vanilla.",
            "Bug-Catching Contest encounters, roaming beasts and authored static scripted wild encounters are intentionally not catch-up scaled.",
            "Silver's Victory Road encounter is armed only after eight genuine Johto badges; Mt. Moon is armed only after Gold Hall of Fame.",
            "Position import remains direct-map only where Gold and Gen 1 map identity is safely compatible.",
            "This mod requests filesystem and engine_internals permissions.",
        },
    },

    compat = {
        engine = ">=0.1.78 <0.2.0",
        modApi = 2,
    },
}
